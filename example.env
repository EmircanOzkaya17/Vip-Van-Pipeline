# =============================================================================
# vip_van_pipeline - ornek ortam dosyasi
# =============================================================================
# Kullanim:  bu dosyayi ".env" adiyla kopyalayin ve gerekirse duzenleyin.
#   Windows : copy example.env .env
#   Linux   : cp example.env .env
#
# Oncelik sirasi: gercek ortam degiskeni > .env > koddaki varsayilan
# Bos birakilan her deger, src/config.py icindeki varsayilani kullanir.
# =============================================================================


# -----------------------------------------------------------------------------
# Arac tespiti ve takip (Ultralytics)
# -----------------------------------------------------------------------------
# YOLO model dosyasi. Diskte yoksa Ultralytics ilk calistirmada indirir.
# Ornek: yolo11n.pt (hizli) | yolo11m.pt (dengeli) | yolo11x.pt (en dogru)
YOLO_MODEL_PATH=yolo11m.pt

# Ultralytics tracker yapilandirmasi: botsort.yaml | bytetrack.yaml
TRACKER_CONFIG=botsort.yaml


# -----------------------------------------------------------------------------
# Arac tipi siniflandirma (OpenCLIP)
# -----------------------------------------------------------------------------
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k


# -----------------------------------------------------------------------------
# Plaka tespiti ve OCR
# -----------------------------------------------------------------------------
# Plaka dedektoru arka ucu:
#   auto        -> models/ icindeki dosya varsa OpenCV DNN, yoksa onnxruntime
#   opencv      -> yalnizca OpenCV DNN (ek paket gerekmez)
#   onnxruntime -> open-image-models paketi uzerinden
PLATE_DETECTOR_BACKEND=auto

# Sirayla denenecek OCR motorlari: fastplate | fastplate,paddle
PLATE_OCR_ENGINES=fastplate

# Model dosyasi yollari. Bos birakilirsa models/ altindaki dosyalar kullanilir.
PLATE_DETECTOR_ONNX=
PLATE_OCR_FAST_ONNX=

# Yalnizca PLATE_DETECTOR_BACKEND=onnxruntime icin
PLATE_DETECTOR_MODEL=yolo-v9-t-384-license-plate-end2end

# Yalnizca PLATE_OCR_ENGINES icinde "paddle" varsa
PADDLEOCR_LANG=en

# PaddleX model onbellegi. Kullanici klasorunuzde Turkce/ASCII olmayan karakter
# varsa (ornek: C:\Users\ÖZKAYA) ASCII bir yol verin: C:\paddlex_cache
# Bos birakilirsa otomatik ASCII yedek yollar denenir.
PADDLEX_CACHE_HOME=


# -----------------------------------------------------------------------------
# Cikti klasorleri
# -----------------------------------------------------------------------------
# Islenen videonun, kaynak videonun yanindaki hangi alt klasore yazilacagi
OUTPUT_DIR_NAME=islenmis

# RTSP / kamera kaynaklarinda ciktinin yazilacagi klasor (calisma dizini altinda)
OUTPUT_STREAM_DIR_NAME=vip_van_kayitlari
